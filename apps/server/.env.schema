# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @public @type=url
S3_ENDPOINT=

# @public @type=string(minLength=1)
S3_REGION=

# @public @type=string(minLength=1)
S3_BUCKET=

# @type=string(minLength=1)
S3_ACCESS_KEY_ID=

# @type=string(minLength=1)
S3_SECRET_ACCESS_KEY=

# Invite emails go out through the Resend HTTP API.
# @type=string(minLength=1)
RESEND_API_KEY=

# @public @type=string(minLength=1)
RESEND_FROM="Narbel <onboarding@resend.dev>"

# Where the web app lives; invite and share links point at it.
# @public @type=url
WEB_ORIGIN=http://localhost:3002

# Cache and realtime sync fan-out between server instances.
# @type=string(minLength=1)
REDIS_URL=redis://localhost:6379
