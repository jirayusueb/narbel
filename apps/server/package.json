{
  "name": "server",
  "type": "module",
  "main": "src/bootstrap/app.ts",
  "types": "src/bootstrap/app.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/main.ts --outfile server",
    "dev": "bun run --hot src/main.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config auth.config.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@elysia/cors": "^2.0.0-rc.0",
    "@elysia/openapi": "^2.0.0-rc.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@narbel/auth": "workspace:*",
    "@narbel/db": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "catalog:",
    "elysia": "2.0.0-rc.1",
    "lib0": "^0.2.119",
    "varlock": "catalog:",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@narbel/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
