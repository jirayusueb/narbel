{
  "name": "narbel",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "tsrs": "0.20.1-ts7.1.0-beta",
      "@types/bun": "^1.4.3",
      "varlock": "1.23.0",
      "better-auth": "1.7.12",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @narbel/db --",
    "db:studio": "turbo run db:studio -F @narbel/db --",
    "db:generate": "turbo run db:generate -F @narbel/db --",
    "db:migrate": "turbo run db:migrate -F @narbel/db --",
    "db:start": "docker compose up -d postgres",
    "services:start": "docker compose up -d postgres redis s3 s3-setup",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "redproof": "redproof check",
    "redproof:prove": "redproof prove",
    "redproof:describe": "redproof describe"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@narbel/config": "workspace:*",
    "@redproof/dependency-cruiser": "^0.12.0",
    "@types/bun": "catalog:",
    "dependency-cruiser": "^18.7.0",
    "lefthook": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "redproof": "^0.12.0",
    "tsrs": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
